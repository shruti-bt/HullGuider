<?xml version="1.0"?>
<robot name="simple_sub">

  <!-- Base link -->
  <link name="base_link">
    
    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.6" radius="0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.6" radius="0.1"/>
      </geometry>
    </collision>

  </link>

  <!-- Forward direction marker -->
  <link name="nose">
  <visual>
    <origin xyz="0.35 0 0" rpy="0 1.5708 0"/>
    <geometry>
      <cylinder length="0.2" radius="0.05"/>
    </geometry>
    <material name="red">
      <color rgba="1.0 0.2 0.2 1.0"/>
    </material>
  </visual>
</link>

  <joint name="nose_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nose"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>